<?xml version="1.0" encoding="utf-8"?>
<!--
  This legacy file is used on Android 11 and lower. Android backup rules do not support wildcard
  paths, so the full-domain exclusions are intentional: they cover workspaces, snapshots, all
  generated .workspace-*, .legacy-* and .database-* recovery/staging files, recovery journals,
  decrypted/temporary files, DataStore, Room databases, SharedPreferences, and cache paths.

  There are deliberately no include rules. The application AEAD archive is the only supported
  migration/backup path; Android automatic backup must not restore a partial plaintext state.
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />

  <!-- Also deny device-protected storage if a future component uses it. -->
  <exclude domain="device_root" path="." />
  <exclude domain="device_file" path="." />
  <exclude domain="device_database" path="." />
  <exclude domain="device_sharedpref" path="." />
</full-backup-content>
